# Where the API server sends audit events: the KubeScope collector on the host.
apiVersion: v1
kind: Config
clusters:
  - name: kubescope
    cluster:
      server: http://__COLLECTOR_ADDR__/audit
contexts:
  - name: default
    context:
      cluster: kubescope
      user: kubescope
current-context: default
users:
  - name: kubescope
    user: {}
